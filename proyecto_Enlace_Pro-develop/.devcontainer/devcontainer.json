// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
    "name": "alpine",
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "image": "julparper/alpine_node_mvn_git_jdk:v2",
    "forwardPorts": [8080],

    //"features": {
        //"ghcr.io/devcontainers/features/java:1": {},
        //"ghcr.io/devcontainers-extra/features/maven-sdkman:2": {}
//},

	//Montamos las claves ssh para que estén disponibles en el contenedor
    "mounts": [
    // En Windows el env HOME puede no estar definido; usar USERPROFILE para obtener C:\Users\<user>
    "source=${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	
	// FIX: El problema de las fuentes ("Fontconfig head is null") en contenedores minimalistas (Alpine).
    // Java necesita fontconfig y fuentes básicas para renderizar el texto de PlantUML.
    // Se añade 'graphviz' para solucionar el error 'Cannot run program "/opt/local/bin/dot"'.
    "postCreateCommand": "apk update && apk add fontconfig ttf-dejavu graphviz",
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
                // **CONFIGURACIÓN CLAVE:** Forzamos a la extensión 'jebbs.plantuml' a usar
                // el motor JAR actualizado que acabamos de descargar, anulando la versión antigua que fallaba.
                "plantuml.jar": "/usr/local/plantuml/plantuml.jar"
            },
		"extensions": [
			"vmware.vscode-spring-boot",
			"Oracle.oracle-java",
			"vscjava.vscode-java-pack",
			"shd101wyy.markdown-preview-enhanced",
			"yzhang.markdown-all-in-one",
			"bierner.markdown-mermaid",
			"jebbs.plantuml",
			"Mebrahtom.plantumlpreviewer",
			"VMware.vscode-spring-cli",
			"vscjava.vscode-spring-boot-dashboard",
			"mhutchie.git-graph",
			"Postman.postman-for-vscode",
			"vscode-icons-team.vscode-icons",
			"LalithK90.thymeleaf-html5-snippets",
			"vscjava.vscode-lombok",
			"juhahinkula.thymeleaf",
			"vmware.vscode-spring-boot"
			
		]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}